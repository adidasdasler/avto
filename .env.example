# --- Провайдер avtovincod.ru ---
# mock — офлайн-образцы (по умолчанию); live — настоящий API
PROVIDER_MODE=mock
AVC_TOKEN=
AVC_BASE_URL=https://api.avtovincod.ru

# --- Сервер (docker compose) ---
# домен сайта: Caddy получит для него HTTPS-сертификат
DOMAIN=vincv.ru
# пароль PostgreSQL; deploy/setup.sh сгенерирует его сам
POSTGRES_PASSWORD=

# --- База (для запуска без Docker) ---
# DATABASE_URL=postgresql+asyncpg://shturman:shturman@db:5432/shturman
DATABASE_URL=sqlite+aiosqlite:///./shturman.db

# на сервере: https://vincv.ru (ссылки на отчёты в ботах, страницы оплаты)
PUBLIC_BASE_URL=http://localhost:8000
BRAND_NAME=VinCv
FREE_CHECKS_PER_DAY=3
# защита бюджета: бесплатных проверок с одного IP и всего за сутки
FREE_CHECKS_PER_IP_PER_DAY=10
FREE_CHECKS_GLOBAL_PER_DAY=300
TRUST_PROXY_HEADERS=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# provider_token ЮКассы из @BotFather → Payments (для теста — тестовый токен ЮКассы)
TELEGRAM_PAYMENT_TOKEN=
# если api.telegram.org недоступен напрямую: http://user:pass@host:port
TELEGRAM_PROXY=
# только для разработки: кнопки оплаты срабатывают без платёжки
DEV_FAKE_PAYMENTS=false

# --- MAX ---
# токен бота: business.max.ru → Чат-боты → Интеграция → Получить токен
MAX_BOT_TOKEN=
# ссылка на бота, например https://max.ru/shturman_bot (кнопки на сайте и deep-link к проверке)
MAX_BOT_URL=
MAX_API_URL=https://platform-api.max.ru

# дополнительный корневой сертификат (PEM), если сервис подписан УЦ, которого нет в системе
EXTRA_CA_FILE=

# --- Robokassa ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовые платежи (тестовые пароли из ЛК, раздел «Технические настройки»)
ROBOKASSA_TEST=true
# алгоритм подписи, как выбран в ЛК
ROBOKASSA_HASH=md5
# чек по 54-ФЗ (для самозанятых — «Робочеки»)
ROBOKASSA_RECEIPT=true
ROBOKASSA_SNO=
ROBOKASSA_TAX=none
# проверять оплату запросом статуса счёта — работает без публичного сервера
ROBOKASSA_POLL_STATUS=true

# --- Вход через Яндекс ID ---
# oauth.yandex.ru → Создать приложение → Веб-сервисы; Redirect URI: https://vincv.ru/auth/yandex/callback;
# доступы: «Доступ к адресу электронной почты» (login:email) и «Доступ к логину, имени и фамилии» (login:info)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Почта (SMTP): подтверждение адреса и сброс пароля ---
# например Яндекс 360 для домена: smtp.yandex.ru, 465, SSL; логин — адрес ящика, пароль — пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Реквизиты (оферта, политика, контакты; нужны для модерации Robokassa) ---
LEGAL_NAME=
LEGAL_STATUS=
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=

# --- Тревоги сотрудникам (в MAX/Telegram и в панели) ---
# расход сверх наших запросов = кто-то ещё пользуется токеном avtovincod.ru
ALERT_EXTERNAL_SPEND_RUB=50
ALERT_SPEND_HOUR_RUB=500
ALERT_SPEND_DAY_RUB=3000
ALERT_BALANCE_BELOW_RUB=500
ALERT_ERRORS_PER_HOUR=30

# --- Личный кабинет ---
# номера администраторов (виден в кабинете), через запятую — первый вход в панель /admin;
# остальных сотрудников назначают в самой панели. Вход в панель — только с 2FA.
ADMIN_USER_IDS=
STAFF_MFA_HOURS=12
ANON_CHECKS_RETENTION_DAYS=30

# --- Цены, ₽ ---
PRICE_BASIC=199
PRICE_DOSSIER=399
PRICE_DOSSIER_PLUS=699
PRICE_PACK_10=850
PRICE_PACK_25=1950
PRICE_PACK_50=3500
