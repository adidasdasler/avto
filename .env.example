# --- Провайдер avtovincod.ru ---
# mock — офлайн-образцы (по умолчанию); live — настоящий API
PROVIDER_MODE=mock
AVC_TOKEN=
AVC_BASE_URL=https://api.avtovincod.ru

# --- База ---
# DATABASE_URL=postgresql+asyncpg://shturman:shturman@db:5432/shturman
DATABASE_URL=sqlite+aiosqlite:///./shturman.db

PUBLIC_BASE_URL=http://localhost:8000
BRAND_NAME=Штурман Авто
FREE_CHECKS_PER_DAY=3
TRUST_PROXY_HEADERS=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# provider_token ЮКассы из @BotFather → Payments (для теста — тестовый токен ЮКассы)
TELEGRAM_PAYMENT_TOKEN=
# если api.telegram.org недоступен напрямую: http://user:pass@host:port
TELEGRAM_PROXY=
# только для разработки: кнопки оплаты срабатывают без платёжки
DEV_FAKE_PAYMENTS=false

# --- MAX ---
# токен бота: business.max.ru → Чат-боты → Интеграция → Получить токен
MAX_BOT_TOKEN=
# ссылка на бота, например https://max.ru/shturman_bot (кнопки на сайте и deep-link к проверке)
MAX_BOT_URL=
MAX_API_URL=https://platform-api2.max.ru

# --- Robokassa ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовые платежи (тестовые пароли из ЛК, раздел «Технические настройки»)
ROBOKASSA_TEST=true
# алгоритм подписи, как выбран в ЛК
ROBOKASSA_HASH=md5
# чек по 54-ФЗ (для самозанятых — «Робочеки»)
ROBOKASSA_RECEIPT=true
ROBOKASSA_SNO=
ROBOKASSA_TAX=none
# проверять оплату запросом статуса счёта — работает без публичного сервера
ROBOKASSA_POLL_STATUS=true

# --- Цены, ₽ ---
PRICE_BASIC=199
PRICE_DOSSIER=399
PRICE_DOSSIER_PLUS=699
PRICE_PACK_10=850
PRICE_PACK_25=1950
PRICE_PACK_50=3500
PRICE_UNLIMITED_DAY=1490
