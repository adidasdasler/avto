# --- Провайдер avtovincod.ru ---
# mock — офлайн-образцы (по умолчанию); live — настоящий API
PROVIDER_MODE=mock
AVC_TOKEN=
AVC_BASE_URL=https://api.avtovincod.ru

# --- База ---
# DATABASE_URL=postgresql+asyncpg://shturman:shturman@db:5432/shturman
DATABASE_URL=sqlite+aiosqlite:///./shturman.db

PUBLIC_BASE_URL=http://localhost:8000
BRAND_NAME=Штурман Авто
FREE_CHECKS_PER_DAY=3
TRUST_PROXY_HEADERS=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# provider_token ЮКассы из @BotFather → Payments (для теста — тестовый токен ЮКассы)
TELEGRAM_PAYMENT_TOKEN=
# если api.telegram.org недоступен напрямую: http://user:pass@host:port
TELEGRAM_PROXY=
# только для разработки: кнопки оплаты срабатывают без платёжки
DEV_FAKE_PAYMENTS=false

MAX_BOT_URL=

# --- Цены, ₽ ---
PRICE_BASIC=199
PRICE_DOSSIER=399
PRICE_DOSSIER_PLUS=699
PRICE_PACK_10=850
PRICE_PACK_25=1950
PRICE_PACK_50=3500
